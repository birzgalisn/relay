{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "API_BASE_URL", "CNAME"],
  "tasks": {
    "dev": {
      "dependsOn": ["@repo/shared#build", "@repo/drizzle#db:sync", "api#build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "test": {},
    "db:check": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:sync": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "api#build": {
      "dependsOn": ["@repo/shared#build", "^build"],
      "outputs": ["dist/**"]
    },
    "api#generate:schema": {
      "dependsOn": ["api#build"],
      "outputs": ["src/_generated/schema.graphql"],
      "cache": false
    },
    "@repo/drizzle#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@repo/codegen#generate": {
      "dependsOn": ["api#build"],
      "cache": false
    },
    "@repo/codegen#dev": {
      "dependsOn": ["api#build"],
      "cache": false,
      "persistent": true
    },
    "web#generate": {
      "dependsOn": ["@repo/codegen#generate"],
      "cache": false
    },
    "web#check-types": {
      "dependsOn": ["generate", "^check-types"],
      "cache": false
    },
    "api#check-types": {
      "dependsOn": ["^build", "^check-types"],
      "cache": false
    },
    "@repo/shared#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@repo/drizzle#check-types": {
      "dependsOn": ["^check-types"],
      "cache": false
    }
  }
}
