{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "nest start --watch --no-shell",
    "dev:debug": "nest start --debug --watch --no-shell",
    "build": "tsdown",
    "generate:schema": "node dist/write-graphql-schema.js",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo coverage src/_generated tsconfig.tsbuildinfo",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@as-integrations/fastify": "catalog:",
    "@fastify/static": "catalog:",
    "@nestjs/apollo": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@repo/drizzle": "workspace:*",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "@tus/file-store": "catalog:",
    "@tus/server": "catalog:",
    "bullmq": "catalog:",
    "fastify": "catalog:",
    "graphql": "catalog:",
    "graphql-redis-subscriptions": "catalog:",
    "graphql-subscriptions": "catalog:",
    "ioredis": "catalog:",
    "nsfwjs": "catalog:",
    "@tensorflow/tfjs": "catalog:",
    "@tensorflow/tfjs-backend-wasm": "catalog:",
    "@img/sharp-libvips-linux-x64": "catalog:",
    "@img/sharp-linux-x64": "catalog:",
    "sharp": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/oxlint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "source-map-support": "catalog:",
